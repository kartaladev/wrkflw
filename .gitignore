.superpowers/

# Compiled example binaries dropped at repo root by `go build ./examples/<name>/`
# (leading slash anchors to root so the examples/<name>/ source dirs stay tracked).
# One entry per main package under examples/, INCLUDING examples/scenarios/<name>,
# because go build names the output after the package dir's basename regardless of
# nesting. Adding an example without adding its entry here leaks a ~12-33MB binary
# into git. Re-audit with:
#
#   for d in $(go list -f '{{if eq .Name "main"}}{{.Dir}}{{end}}' ./examples/...); do \
#     grep -qxF "/$(basename $d)" .gitignore || echo "MISSING /$(basename $d)"; done
#
# examples/<name>
/authenticated_tasks
/broker_wiring
/builtin_actions
/cache_wiring
/chaining_wiring
/migrate
/mysql_wiring
/production_wiring
/readme_quickstart
/real_db_transaction
/scenarios
/sqlite_wiring
