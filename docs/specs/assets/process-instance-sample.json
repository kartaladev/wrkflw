  "definition": {
    "id": "order-approval",
    "version": 3,
    "scoped_actions": ["charge-card"],
    "nodes": [
      {
        "id": "start",
        "kind": "startEvent",
        "name": "Start",
        "label": "Order received"
      },
      {
        "id": "charge",
        "kind": "serviceTask",
        "name": "Charge Card",
        "label": "Charge the customer's card",
        "action": "charge-card"
      },
      {
        "id": "manager_review",
        "kind": "userTask",
        "name": "Manager Review",
        "label": "Manager sign-off on order",
        "eligible_roles": ["manager"],
        "outcomes": ["approve", "reject", "revise"],
        "outcome_variable": "manager_approved"
      },
      {
        "id": "manager_decision",
        "kind": "exclusiveGateway",
        "name": "Manager Approved?",
        "label": "Did the manager approve?"
      },
      {
        "id": "finance_approval",
        "kind": "userTask",
        "name": "Finance Approval",
        "label": "Finance approval of spend",
        "eligible_roles": ["finance"],
        "outcomes": ["approve", "reject"],
        "outcome_variable": "finance_approved"
      },
      {
        "id": "finance_decision",
        "kind": "exclusiveGateway",
        "name": "Finance Approved?",
        "label": "Did finance approve?"
      },
      {
        "id": "fulfill",
        "kind": "serviceTask",
        "name": "Fulfill Order",
        "label": "Ship the order to the customer",
        "action": "ship-order"
      },
      {
        "id": "notify_rejection",
        "kind": "serviceTask",
        "name": "Notify Rejection",
        "label": "Email the customer about the rejection",
        "action": "send-rejection-email"
      },
      {
        "id": "approved_end",
        "kind": "endEvent",
        "name": "Approved End",
        "label": "Order completed"
      },
      {
        "id": "rejected_end",
        "kind": "endEvent",
        "name": "Rejected End",
        "label": "Order rejected"
      }
    ],
    "flows": [
      {
        "id": "start->charge",
        "source": "start",
        "target": "charge"
      },
      {
        "id": "charge->manager_review",
        "source": "charge",
        "target": "manager_review"
      },
      {
        "id": "manager_review->manager_decision",
        "source": "manager_review",
        "target": "manager_decision"
      },
      {
        "id": "manager_decision->finance_approval",
        "source": "manager_decision",
        "target": "finance_approval",
        "condition": "manager_approved == \"approve\""
      },
      {
        "id": "manager_decision->notify_rejection",
        "source": "manager_decision",
        "target": "notify_rejection",
        "is_default": true
      },
      {
        "id": "finance_approval->finance_decision",
        "source": "finance_approval",
        "target": "finance_decision"
      },
      {
        "id": "finance_decision->fulfill",
        "source": "finance_decision",
        "target": "fulfill",
        "condition": "finance_approved == \"approve\""
      },
      {
        "id": "finance_decision->notify_rejection",
        "source": "finance_decision",
        "target": "notify_rejection",
        "is_default": true
      },
      {
        "id": "fulfill->approved_end",
        "source": "fulfill",
        "target": "approved_end"
      },
      {
        "id": "notify_rejection->rejected_end",
        "source": "notify_rejection",
        "target": "rejected_end"
      }
    ],
    "cancel_actions": ["refund"]
  }
}
