{
  "id": "golden",
  "version": 7,
  "nodes": [
    {
      "id": "start",
      "kind": "startEvent",
      "name": "Start",
      "timer_trigger": {
        "kind": "expr",
        "expr": "1h"
      },
      "signal_name": "go",
      "message_name": "kickoff",
      "correlation_key": "orderId"
    },
    {
      "id": "charge",
      "kind": "serviceTask",
      "name": "Charge",
      "action": "charge-card",
      "deadline_trigger": {
        "kind": "expr",
        "expr": "2h"
      },
      "wait_trigger": {
        "kind": "everyExpr",
        "expr": "30m"
      },
      "deadline_flow": "sla-flow",
      "deadline_action": "notify-ops",
      "wait_action": "ping",
      "retry_policy": {
        "max_attempts": 5,
        "initial_interval": 2000000000,
        "backoff_coef": 2,
        "max_interval": 90000000000,
        "max_elapsed": 600000000000,
        "non_retryable_errors": [
          "fatal",
          "denied"
        ]
      },
      "recovery_flow": "charge-\u003efallback",
      "compensate_action": "refund-card",
      "cancel_action": "abort-charge"
    },
    {
      "id": "approve",
      "kind": "userTask",
      "name": "Approve",
      "eligible_roles": [
        "manager",
        "director"
      ],
      "eligible_privileges": [
        "finance-task claim",
        "finance-task complete"
      ],
      "eligible_expr": "vars[\"region\"] == \"EU\""
    },
    {
      "id": "await",
      "kind": "receiveTask",
      "name": "Await Payment",
      "message_name": "payment-confirmed",
      "correlation_key": "orderId"
    },
    {
      "id": "notify",
      "kind": "sendTask",
      "name": "Notify",
      "message_name": "shipment-ready",
      "correlation_key": "orderId"
    },
    {
      "id": "score",
      "kind": "businessRuleTask",
      "name": "Score",
      "action": "risk-score"
    },
    {
      "id": "packing",
      "kind": "subProcess",
      "name": "Packing",
      "subprocess": {
        "id": "sub",
        "version": 1,
        "nodes": [
          {
            "id": "sub-start",
            "kind": "startEvent"
          },
          {
            "id": "sub-end",
            "kind": "endEvent"
          }
        ],
        "flows": [
          {
            "id": "sf1",
            "source": "sub-start",
            "target": "sub-end"
          }
        ]
      }
    },
    {
      "id": "fulfil",
      "kind": "callActivity",
      "name": "Fulfil",
      "def_ref": "fulfilment-def"
    },
    {
      "id": "compensator",
      "kind": "subProcess",
      "name": "Compensator",
      "subprocess": {
        "id": "sub",
        "version": 1,
        "nodes": [
          {
            "id": "sub-start",
            "kind": "startEvent",
            "signal_name": "recover",
            "non_interrupting": true
          },
          {
            "id": "sub-end",
            "kind": "endEvent"
          }
        ],
        "flows": [
          {
            "id": "sf1",
            "source": "sub-start",
            "target": "sub-end"
          }
        ]
      }
    },
    {
      "id": "wait",
      "kind": "intermediateCatchEvent",
      "name": "Wait",
      "timer_trigger": {
        "kind": "expr",
        "expr": "15m"
      },
      "deadline_trigger": {
        "kind": "expr",
        "expr": "4h"
      },
      "wait_trigger": {
        "kind": "everyExpr",
        "expr": "1h"
      },
      "deadline_flow": "wait-\u003eesc",
      "deadline_action": "escalate",
      "wait_action": "nudge",
      "signal_name": "resume",
      "message_name": "go-on",
      "correlation_key": "orderId"
    },
    {
      "id": "emit",
      "kind": "intermediateThrowEvent",
      "name": "Emit",
      "signal_name": "done"
    },
    {
      "id": "compensate",
      "kind": "compensationThrowEvent",
      "name": "Compensate",
      "compensate_ref": "charge"
    },
    {
      "id": "timeout",
      "kind": "boundaryEvent",
      "name": "Timeout",
      "timer_trigger": {
        "kind": "expr",
        "expr": "5m"
      },
      "signal_name": "abort",
      "message_name": "cancel",
      "correlation_key": "orderId",
      "error_code": "E_TIMEOUT",
      "attached_to": "charge",
      "non_interrupting": true
    },
    {
      "id": "xor",
      "kind": "exclusiveGateway",
      "name": "XOR"
    },
    {
      "id": "and",
      "kind": "parallelGateway",
      "name": "AND"
    },
    {
      "id": "or",
      "kind": "inclusiveGateway",
      "name": "OR"
    },
    {
      "id": "race",
      "kind": "eventBasedGateway",
      "name": "RACE"
    },
    {
      "id": "kill",
      "kind": "endEvent",
      "name": "Kill",
      "end_behavior": "terminate",
      "termination_reason": "operator-initiated kill",
      "termination_outcome": "abort"
    },
    {
      "id": "boom",
      "kind": "endEvent",
      "name": "Boom",
      "error_code": "E_BOOM",
      "end_behavior": "error"
    },
    {
      "id": "end",
      "kind": "endEvent",
      "name": "End"
    }
  ],
  "flows": [
    {
      "id": "f1",
      "source": "start",
      "target": "charge"
    },
    {
      "id": "f2",
      "source": "charge",
      "target": "xor"
    },
    {
      "id": "f3",
      "source": "xor",
      "target": "approve",
      "condition": "amount \u003e 100"
    },
    {
      "id": "f4",
      "source": "xor",
      "target": "end",
      "is_default": true
    }
  ],
  "cancel_actions": [
    "cancel-a",
    "cancel-b"
  ]
}
